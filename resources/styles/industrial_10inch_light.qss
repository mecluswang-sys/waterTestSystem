/*
  Industrial 10-inch Touch UI Theme (Qt6) - Light
  Design goals:
  - Bright gray/white surfaces for daylight environments
  - Large touch targets (>=44px)
  - Consistent spacing and a calm industrial accent
*/

/* Base */
QWidget {
    background-color: #eceff2;
    color: #1f2328;
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC";
    font-size: 12pt;
}

QMainWindow {
    background-color: #eceff2;
}

/* Top bar (Station + Terminal) */
QWidget#topBar {
    background-color: #f6f7f8;
    border-bottom: 1px solid #d0d7de;
}
QLabel#topTitle {
    background: transparent;
    font-size: 16pt;
    font-weight: 800;
    color: #1f2328;
}
QLabel#topTime {
    background: transparent;
    font-size: 11pt;
    color: #57606a;
}

/* Tone labels */
QLabel[tone="good"] { color: #1a7f37; font-weight: 800; }
QLabel[tone="warn"] { color: #9a6700; font-weight: 800; }
QLabel[tone="bad"]  { color: #d1242f; font-weight: 800; }
QLabel[tone="info"] { color: #0969da; font-weight: 800; }
QLabel[tone="muted"] { color: #57606a; }

/* Menus */
QMenuBar {
    background-color: #f6f7f8;
    border-bottom: 1px solid #d0d7de;
}
QMenuBar::item {
    padding: 10px 14px;
    background: transparent;
}
QMenuBar::item:selected {
    background-color: #eaeef2;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    padding: 6px;
}
QMenu::item {
    padding: 10px 14px;
    border-radius: 8px;
}
QMenu::item:selected {
    background-color: #ddf4ff;
}

/* Status bar */
QStatusBar {
    background-color: #f6f7f8;
    border-top: 1px solid #d0d7de;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #d0d7de;
    background-color: #eceff2;
}
QTabBar::tab {
    min-height: 48px;
    min-width: 170px;
    padding: 10px 18px;
    margin-right: 4px;
    border: 1px solid #d0d7de;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    background-color: #ffffff;
    color: #1f2328;
    font-weight: 650;
}
QTabBar::tab:selected {
    background-color: #ddf4ff;
    color: #0969da;
    border-bottom-color: #ddf4ff;
}
QTabBar::tab:hover:!selected {
    background-color: #f6f8fa;
}

/* Group boxes */
QGroupBox {
    border: 1px solid #d0d7de;
    border-radius: 12px;
    margin-top: 22px;
    padding: 12px;
    background-color: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 10px;
    color: #0969da;
    font-weight: 800;
}

/* Buttons */
QPushButton {
    min-height: 44px;
    padding: 10px 18px;
    border-radius: 12px;
    border: 1px solid #d0d7de;
    background-color: #ffffff;
    color: #1f2328;
    font-weight: 650;
}
QPushButton:hover {
    background-color: #f6f8fa;
    border-color: #afb8c1;
}
QPushButton:pressed {
    background-color: #eaeef2;
}
QPushButton:disabled {
    background-color: #f6f7f8;
    color: #8c959f;
    border-color: #d0d7de;
}

/* Semantic tone buttons */
QPushButton[tone="good"] { background-color: #1a7f37; border-color: #1a7f37; color: #ffffff; }
QPushButton[tone="good"]:hover { background-color: #218b43; border-color: #218b43; }
QPushButton[tone="warn"] { background-color: #9a6700; border-color: #9a6700; color: #ffffff; }
QPushButton[tone="warn"]:hover { background-color: #b58407; border-color: #b58407; }
QPushButton[tone="bad"]  { background-color: #d1242f; border-color: #d1242f; color: #ffffff; }
QPushButton[tone="bad"]:hover  { background-color: #e5534b; border-color: #e5534b; }
QPushButton[tone="info"] { background-color: #0969da; border-color: #0969da; color: #ffffff; }
QPushButton[tone="info"]:hover { background-color: #1f7ef2; border-color: #1f7ef2; }
QPushButton[tone="neutral"] { background-color: #6e7781; border-color: #6e7781; color: #ffffff; }
QPushButton[tone="neutral"]:hover { background-color: #818b98; border-color: #818b98; }

QPushButton[size="xl"] { font-size: 16pt; padding: 12px 18px; }
QPushButton[size="lg"] { font-size: 13pt; padding: 12px 16px; }

/* Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    min-height: 40px;
    padding: 6px 12px;
    border-radius: 12px;
    border: 1px solid #d0d7de;
    background-color: #ffffff;
    selection-background-color: #0969da;
}
QComboBox::drop-down {
    width: 28px;
    border-left: 1px solid #d0d7de;
}

/* Tables */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f6f8fa;
    gridline-color: #d0d7de;
    border: 1px solid #d0d7de;
    border-radius: 12px;
}
QHeaderView::section {
    background-color: #f6f7f8;
    color: #1f2328;
    padding: 10px 12px;
    border: 1px solid #d0d7de;
    font-weight: 800;
}
QTableWidget::item { padding: 8px; }
QTableWidget::item:selected { background-color: #ddf4ff; color: #1f2328; }

/* Progress */
QProgressBar {
    min-height: 22px;
    border-radius: 12px;
    border: 1px solid #d0d7de;
    background-color: #ffffff;
    text-align: center;
}
QProgressBar::chunk {
    border-radius: 12px;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1a7f37, stop:1 #0969da);
}

/* Badges (status pills) */
QLabel#badge {
    padding: 6px 12px;
    border-radius: 12px;
    border: 1px solid #d0d7de;
    background-color: #ffffff;
    font-weight: 900;
    color: #57606a;
}
QLabel#badge[tone="good"] { color: #1a7f37; border-color: #1a7f37; }
QLabel#badge[tone="warn"] { color: #9a6700; border-color: #9a6700; }
QLabel#badge[tone="bad"]  { color: #d1242f; border-color: #d1242f; }
QLabel#badge[tone="info"] { color: #0969da; border-color: #0969da; }

/* Generic boxes used by panels */
QLabel[role="metricBlock"] {
    padding: 8px 10px;
    border: 2px solid #d0d7de;
    border-radius: 12px;
    background-color: #ffffff;
    font-family: Consolas, "Cascadia Mono", "Courier New", monospace;
    font-size: 11pt;
    font-weight: 800;
}
QLabel[role="valueBox"] {
    padding: 8px 10px;
    border: 1px solid #d0d7de;
    border-radius: 12px;
    background-color: #ffffff;
    font-weight: 800;
}
QLabel[role="statusBox"] {
    padding: 6px 10px;
    border: 2px solid #d0d7de;
    border-radius: 12px;
    background-color: #ffffff;
    font-weight: 800;
}
QLabel[role="flowDiagram"] {
    padding: 14px;
    border: 2px solid #0969da;
    border-radius: 14px;
    background-color: #ffffff;
    font-family: Consolas, "Cascadia Mono", "Courier New", monospace;
    font-size: 12pt;
}

/* HMI yellow tag box (SCADA-style) */
QWidget#hmiTag {
    background-color: #ffd33d;
    border: 2px solid #9a6700;
    border-radius: 8px;
}
QLabel#hmiTagTitle {
    background: transparent;
    color: #1f2328;
    font-size: 9pt;
    font-weight: 900;
}
QLabel#hmiTagValue {
    background: transparent;
    color: #1f2328;
    font-size: 11pt;
    font-weight: 950;
}

/* Console blocks (keep readable on light theme) */
QFrame#hmiConsole {
    background-color: rgba(255, 255, 255, 245);
    border: 2px solid #d0d7de;
    border-radius: 12px;
}
QLabel#consoleTitle {
    color: #0969da;
    font-size: 12pt;
    font-weight: 900;
    letter-spacing: 1px;
}
QFrame#hmiConsole QLabel {
    color: #1f2328;
}
QFrame#dangerBlock {
    background-color: rgba(209, 36, 47, 20);
    border: 2px solid rgba(209, 36, 47, 140);
    border-radius: 12px;
}
QFrame#dangerBlock QLabel {
    color: #d1242f;
    font-weight: 900;
}
